<% content_for :title, "Walk" %>

<div class="mb-8">
  <h1 class="text-2xl font-semibold tracking-tight text-stone-900">The walk</h1>
  <p class="mt-1 max-w-2xl text-sm text-stone-500">
    One probe, every pot, in room order. Record each reading as you go — the same
    round a voice assistant runs from
    <%= link_to "this list as JSON", walk_pots_path(format: :json), class: "text-emerald-700 underline" %>.
  </p>
</div>

<% if @pots.empty? %>
  <p class="rounded-lg border border-dashed border-stone-300 bg-white p-10 text-center text-stone-600">
    No pots to walk yet.
  </p>
<% else %>
  <ol class="space-y-3">
    <% @pots.each_with_index do |pot, index| %>
      <li class="rounded-lg border <%= pot.needs_check? ? "border-emerald-300 bg-white" : "border-stone-200 bg-stone-100/60" %> p-4">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <p class="text-xs uppercase tracking-wide text-stone-400">
              <%= index + 1 %> &middot; <%= spot_label(pot.spot) %>
            </p>
            <p class="mt-1 font-medium text-stone-900"><%= pot.probe_prompt %></p>
            <p class="mt-1 text-sm text-stone-500">
              <% if pot.latest_reading %>
                Last read <%= day_count pot.latest_reading.read_at.to_date %>
                at <%= pot.latest_reading.value.to_i %>%.
              <% else %>
                Never read.
              <% end %>
              <% unless pot.semi_hydro? %>
                Dry below <%= pot.dry_below %>%.
              <% end %>
            </p>
          </div>

          <%= status_badge pot.status %>
        </div>

        <%= form_with url: pot_moisture_readings_path(pot), class: "mt-3 flex flex-wrap items-center gap-2" do |form| %>
          <%= form.hidden_field :"moisture_reading[source]", value: "walk", name: "moisture_reading[source]" %>
          <%= form.number_field :"moisture_reading[value]", name: "moisture_reading[value]",
                in: 0..100, step: 0.1, placeholder: "reading %", required: true,
                class: "w-32 rounded-md border border-stone-300 px-2 py-1.5 text-sm" %>
          <%= form.submit "Record", class: button_classes %>
        <% end %>
      </li>
    <% end %>
  </ol>
<% end %>
