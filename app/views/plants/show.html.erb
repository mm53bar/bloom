<% content_for :title, @plant.name %>

<div class="mb-8 flex flex-wrap items-start justify-between gap-4">
  <div>
    <p class="text-sm text-stone-500">
      <%= link_to @plant.pot.name, @plant.pot, class: "hover:text-emerald-800" %>
      &middot; <%= link_to spot_label(@plant.spot), @plant.spot, class: "hover:text-emerald-800" %>
    </p>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight text-stone-900"><%= @plant.name %></h1>
    <% if @plant.species.present? %>
      <p class="text-sm italic text-stone-500"><%= @plant.species %></p>
    <% end %>
  </div>

  <%= link_to "Edit", edit_plant_path(@plant), class: button_classes(:secondary) %>
</div>

<div class="rounded-lg border border-stone-200 bg-white p-5">
  <dl class="space-y-2 text-sm">
    <div class="flex justify-between gap-4">
      <dt class="text-stone-500">Needs</dt>
      <dd class="text-stone-800">
        <%= @plant.light_requirement.humanize %> light
        &middot; <%= number_with_precision @plant.dli_required, precision: 1 %> mol/m²/day
      </dd>
    </div>
    <div class="flex justify-between gap-4">
      <dt class="text-stone-500">Gets</dt>
      <dd class="<%= @plant.light_satisfied? ? "text-stone-800" : "text-amber-800" %>">
        <%= number_with_precision @plant.spot.effective_dli, precision: 1 %> mol/m²/day
        <% if @plant.spot.measured? %>
          <span class="text-xs text-stone-400">measured</span>
        <% else %>
          <span class="text-xs text-stone-400">estimated from "<%= @plant.spot.effective_light %>"</span>
        <% end %>
        <%= "— short by #{number_with_precision @plant.light_deficit, precision: 1}" unless @plant.light_satisfied? %>
      </dd>
    </div>
    <% if @plant.acquired_on %>
      <div class="flex justify-between gap-4">
        <dt class="text-stone-500">Acquired</dt>
        <dd class="text-stone-800"><%= @plant.acquired_on.to_fs(:long) %></dd>
      </div>
    <% end %>
    <% if @plant.safe_reference_url %>
      <div class="flex justify-between gap-4">
        <dt class="text-stone-500">Notes</dt>
        <dd><%= link_to "Reference", @plant.safe_reference_url, class: "text-emerald-700 underline" %></dd>
      </div>
    <% end %>
  </dl>

  <% if @plant.notes.present? %>
    <p class="mt-4 whitespace-pre-line text-sm text-stone-600"><%= @plant.notes %></p>
  <% end %>
</div>

<div class="mt-8">
  <%= button_to "Remove this plant", @plant, method: :delete,
        class: button_classes(:danger),
        form: { data: { turbo_confirm: "Remove #{@plant.name}?" } } %>
</div>
