<% content_for :title, "Plants" %>

<div class="mb-8">
  <h1 class="text-2xl font-semibold tracking-tight text-stone-900">Plants</h1>
  <p class="mt-1 text-sm text-stone-500"><%= pluralize @plants.size, "plant" %>.</p>
</div>

<% if @underlit.any? %>
  <section class="mb-8 rounded-lg border border-amber-300 bg-amber-50 p-5">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-amber-900">Wanting more light</h2>
    <p class="mt-1 text-sm text-amber-800">
      These ask for more than their spot provides, counting any grow light. Moving
      them — or adding a light — does more than watering will.
    </p>
    <ul class="mt-3 space-y-1 text-sm">
      <% @underlit.each do |plant| %>
        <li>
          <%= link_to plant.name, plant, class: "font-medium text-amber-900 underline" %>
          <span class="text-amber-800">
            wants <%= plant.light_requirement %>, <%= plant.location.name %> gives
            <%= plant.location.effective_light %>
          </span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<% if @plants.empty? %>
  <p class="rounded-lg border border-dashed border-stone-300 bg-white p-10 text-center text-stone-600">
    No plants yet. Add a pot first, then put something in it.
  </p>
<% else %>
  <ul class="divide-y divide-stone-200 overflow-hidden rounded-lg border border-stone-200 bg-white">
    <% @plants.each do |plant| %>
      <li class="flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
        <div class="min-w-48 grow">
          <%= link_to plant.name, plant, class: "font-medium text-stone-900 hover:text-emerald-800" %>
          <% if plant.species.present? %>
            <span class="text-sm italic text-stone-400"><%= plant.species %></span>
          <% end %>
          <p class="text-sm text-stone-500">
            <%= link_to plant.pot.name, plant.pot, class: "hover:text-emerald-800" %>
            &middot; <%= plant.location.name %>
          </p>
        </div>
        <%= light_badge plant.light_requirement %>
      </li>
    <% end %>
  </ul>
<% end %>
