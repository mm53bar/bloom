<%= form_with model: spot.persisted? ? spot : [ spot.area, spot ], class: "space-y-6" do |form| %>
  <% if spot.errors.any? %>
    <div class="rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-900">
      <p class="font-medium"><%= pluralize(spot.errors.count, "problem") %> stopped this from saving:</p>
      <ul class="mt-1 list-disc pl-5">
        <% spot.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :name, class: "block text-sm font-medium text-stone-700" %>
      <%= form.text_field :name, required: true, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2" %>
      <p class="mt-1 text-xs text-stone-500">Where in <%= spot.area.name %>: a shelf, a sill, the top of a cabinet.</p>
    </div>

    <div>
      <%= form.label :natural_light, class: "block text-sm font-medium text-stone-700" %>
      <%= form.select :natural_light, Spot::LIGHT_LEVELS.map { |l| [ l.humanize, l ] }, {},
            class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2" %>
      <p class="mt-1 text-xs text-stone-500">What this spot gets without any help.</p>
    </div>

    <div>
      <%= form.label :grow_light_entity_id, "Grow light entity", class: "block text-sm font-medium text-stone-700" %>
      <%= form.text_field :grow_light_entity_id, placeholder: "switch.example_grow_light",
            class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2" %>
      <p class="mt-1 text-xs text-stone-500">Optional. Recording one counts this spot a step brighter.</p>
    </div>

    <div>
      <%= form.label :measured_dli, "Measured DLI (mol/m²/day)", class: "block text-sm font-medium text-stone-700" %>
      <%= form.number_field :measured_dli, step: 0.01, min: 0,
            class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2" %>
      <p class="mt-1 text-xs text-stone-500">
        Overrides the estimate implied by the light level above. PPFD × hours × 0.0036,
        or an integrated day from a logging sensor.
      </p>
    </div>

    <div>
      <%= form.label :measured_ppfd, "Measured PPFD (µmol/m²/s)", class: "block text-sm font-medium text-stone-700" %>
      <%= form.number_field :measured_ppfd, step: 0.1, min: 0,
            class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2" %>
    </div>

    <div>
      <%= form.label :light_hours, "Hours of light per day", class: "block text-sm font-medium text-stone-700" %>
      <%= form.number_field :light_hours, step: 0.1, min: 0,
            class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2" %>
    </div>

    <div>
      <%= form.label :measured_at, "Measured on", class: "block text-sm font-medium text-stone-700" %>
      <%= form.date_field :measured_at, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2" %>
    </div>

    <div class="sm:col-span-2">
      <%= form.label :exposure, class: "block text-sm font-medium text-stone-700" %>
      <%= form.text_field :exposure, placeholder: "north wall, opposite the south window",
            class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2" %>
    </div>
  </div>

  <div>
    <%= form.label :notes, class: "block text-sm font-medium text-stone-700" %>
    <%= form.text_area :notes, rows: 3, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2" %>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit class: button_classes %>
    <%= link_to "Cancel", spot.area, class: button_classes(:secondary) %>
  </div>
<% end %>
