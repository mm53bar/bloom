<% content_for :title, "Locations" %>

<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight text-stone-900">Locations</h1>
    <p class="mt-1 max-w-2xl text-sm text-stone-500">
      What each spot provides. A grow light counts as one step brighter than the
      natural light, which is what decides whether a plant's needs are met.
    </p>
  </div>

  <%= link_to "Add a location", new_location_path, class: button_classes %>
</div>

<% if @locations.empty? %>
  <p class="rounded-lg border border-dashed border-stone-300 bg-white p-10 text-center text-stone-600">
    No locations yet.
  </p>
<% else %>
  <ul class="divide-y divide-stone-200 overflow-hidden rounded-lg border border-stone-200 bg-white">
    <% @locations.each do |location| %>
      <li class="flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
        <div class="min-w-48 grow">
          <%= link_to location.name, location, class: "font-medium text-stone-900 hover:text-emerald-800" %>
          <p class="text-sm text-stone-500">
            <%= pluralize location.pots.size, "pot" %>
            <%= "· #{location.exposure}" if location.exposure.present? %>
          </p>
        </div>

        <%= light_badge location.natural_light %>

        <% if location.grow_light? %>
          <span class="rounded border border-emerald-300 bg-emerald-50 px-2 py-0.5 text-xs text-emerald-900">
            + grow light
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
