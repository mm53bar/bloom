<% content_for :title, @location.name %>

<div class="mb-8 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight text-stone-900"><%= @location.name %></h1>
    <p class="mt-2 flex flex-wrap items-center gap-2 text-sm text-stone-500">
      <%= light_badge @location.natural_light %>
      <% if @location.grow_light? %>
        <span class="rounded border border-emerald-300 bg-emerald-50 px-2 py-0.5 text-xs text-emerald-900">
          + grow light
        </span>
        <span class="text-stone-400">effectively <%= @location.effective_light %></span>
      <% end %>
    </p>
    <% if @location.exposure.present? %>
      <p class="mt-2 text-sm text-stone-600"><%= @location.exposure %></p>
    <% end %>
  </div>

  <div class="flex gap-2">
    <%= link_to "Edit", edit_location_path(@location), class: button_classes(:secondary) %>
  </div>
</div>

<% if @location.notes.present? %>
  <p class="mb-6 whitespace-pre-line text-sm text-stone-600"><%= @location.notes %></p>
<% end %>

<h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-stone-500">Pots here</h2>

<% if @pots.empty? %>
  <p class="rounded-lg border border-dashed border-stone-300 bg-white p-8 text-center text-stone-500">
    Nothing in this spot yet.
  </p>
<% else %>
  <ul class="divide-y divide-stone-200 overflow-hidden rounded-lg border border-stone-200 bg-white">
    <% @pots.each do |pot| %>
      <li class="flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
        <div class="grow">
          <%= link_to pot.name, pot, class: "font-medium text-stone-900 hover:text-emerald-800" %>
          <p class="text-sm text-stone-500"><%= pot.plants.map(&:name).to_sentence.presence || "no plants recorded" %></p>
        </div>
        <%= status_badge pot.status %>
      </li>
    <% end %>
  </ul>
<% end %>

<div class="mt-8">
  <%= button_to "Remove this location", @location, method: :delete,
        class: button_classes(:danger),
        form: { data: { turbo_confirm: "Remove #{@location.name} and every pot in it?" } } %>
</div>
