<%= form_with model: area, class: "space-y-6" do |form| %>
  <% if area.errors.any? %>
    <div class="rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-900">
      <p class="font-medium"><%= pluralize(area.errors.count, "problem") %> stopped this from saving:</p>
      <ul class="mt-1 list-disc pl-5">
        <% area.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :name, class: "block text-sm font-medium text-stone-700" %>
      <%= form.text_field :name, required: true, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2" %>
      <p class="mt-1 text-xs text-stone-500">A part of the house: a room, a deck, a balcony.</p>
    </div>

    <div>
      <%= form.label :position, "Walk order", class: "block text-sm font-medium text-stone-700" %>
      <%= form.number_field :position, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2" %>
    </div>

    <div class="sm:col-span-2">
      <%= form.label :ha_area, "Home Assistant area", class: "block text-sm font-medium text-stone-700" %>
      <%= form.text_field :ha_area, placeholder: "living_room",
            class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2" %>
      <p class="mt-1 text-xs text-stone-500">
        Optional. Home Assistant calls this level an area too, so it pairs one-to-one.
      </p>
    </div>
  </div>

  <div>
    <%= form.label :notes, class: "block text-sm font-medium text-stone-700" %>
    <%= form.text_area :notes, rows: 3, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2" %>
  </div>

  <p class="rounded border border-stone-200 bg-stone-50 p-3 text-xs text-stone-500">
    Light isn't set here — it belongs to the spots inside this area, because a shelf in
    a window and a shelf across the room from it are nothing alike. A new area starts
    with one spot named after it; add another when the light differs.
  </p>

  <div class="flex items-center gap-3">
    <%= form.submit class: button_classes %>
    <%= link_to "Cancel", area.persisted? ? area : areas_path, class: button_classes(:secondary) %>
  </div>
<% end %>
